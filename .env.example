# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored so real secrets never get committed.

POSTGRES_USER=gapflush
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gapflush

MINIO_ROOT_USER=gapflush
MINIO_ROOT_PASSWORD=changeme12345

# Origin the browser-side React app is served from, for backend CORS.
# Only matters if the frontend is reached directly (bypassing Nginx).
FRONTEND_ORIGIN=http://localhost

# First-run only: creates the initial root_admin user if none exists yet.
# Safe to leave blank after that user has been created.
# NOTE: avoid RFC 2606 reserved domains here (example.com, .test, .local,
# etc.) -- pydantic's email validator rejects them, including on output.
ROOT_ADMIN_USERNAME=admin
ROOT_ADMIN_EMAIL=admin@yourcompany.com
ROOT_ADMIN_PASSWORD=changeme
