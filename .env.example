# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored so real secrets never get committed.

POSTGRES_USER=gapflush
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gapflush

MINIO_ROOT_USER=gapflush
MINIO_ROOT_PASSWORD=changeme12345

# Origin the browser-side React app is served from, for backend CORS.
# Only matters if the frontend is reached directly (bypassing Nginx).
FRONTEND_ORIGIN=http://localhost

# First-run only: creates the initial root_admin user if none exists yet.
# Safe to leave blank after that user has been created.
# NOTE: avoid RFC 2606 reserved domains here (example.com, .test, .local,
# etc.) -- pydantic's email validator rejects them, including on output.
ROOT_ADMIN_FIRST_NAME=Admin
ROOT_ADMIN_LAST_NAME=User
ROOT_ADMIN_EMAIL=admin@yourcompany.com
ROOT_ADMIN_PASSWORD=changeme

# Encrypts Postgres/MinIO service credentials stored via the admin
# "Postgres services" / "MinIO services" pages before they hit the DB.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must stay the same across restarts, or every stored service's
# credentials become undecryptable.
SERVICE_CREDENTIAL_KEY=

# Shared secret MinIO presents when forwarding its log events to the
# backend for the admin log viewer (see MINIO_LOGGER_WEBHOOK_* in
# docker-compose.yml, and api/internal_logs.py).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving this blank disables that endpoint entirely rather than leaving
# it unauthenticated -- an open endpoint that appends to the log store
# would let anyone forge entries and push real ones out of retention.
MINIO_LOG_WEBHOOK_TOKEN=

# Everything below is commented out -- leaving it unset gets exactly
# today's dev-friendly behaviour (plain HTTP, Mailhog, no Postgres/MinIO
# TLS). An internet-facing host sets real values for these instead; see
# .env.preprod.example and docs/PREPROD_DEPLOY.md.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM_ADDRESS=noreply@stackfitpro.com
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# COOKIE_SECURE=false
# POSTGRES_SSLMODE=prefer
# MINIO_SECURE=false
