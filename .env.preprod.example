# Copy this to .env on an internet-facing pre-production host (behind a
# Cloudflare Tunnel -- see docs/PREPROD_DEPLOY.md for the full deploy
# procedure) and fill in real values. .env is gitignored so real secrets
# never get committed.
#
# This is .env.example's exact same key set, with the hardening values
# actually set instead of left at their dev-friendly defaults -- keep
# the two files' shared keys in sync if either one changes.

POSTGRES_USER=gapflush
POSTGRES_PASSWORD=
POSTGRES_DB=gapflush

MINIO_ROOT_USER=gapflush
MINIO_ROOT_PASSWORD=

# The real public domain, over HTTPS -- the Cloudflare Tunnel is what
# makes this true, not anything in this repo.
FRONTEND_ORIGIN=https://yourdomain.com

# NOTE: avoid RFC 2606 reserved domains here (example.com, .test, .local,
# etc.) -- pydantic's email validator rejects them, including on output.
ROOT_ADMIN_FIRST_NAME=Admin
ROOT_ADMIN_LAST_NAME=User
ROOT_ADMIN_EMAIL=admin@yourcompany.com
ROOT_ADMIN_PASSWORD=

SERVICE_CREDENTIAL_KEY=
MINIO_LOG_WEBHOOK_TOKEN=

# --- The hardening block -- see docs/PREPROD_DEPLOY.md for each one ---

# Resend's REST API, not Mailhog -- docker-compose.preprod.yml never
# starts Mailhog on this host, so this must be a real API key before any
# invite/password-reset email can send. core/email.py's
# validate_email_settings() refuses to boot if EMAIL_PROVIDER=resend and
# RESEND_API_KEY is blank, so a half-done value here fails loudly instead
# of silently dropping every email. Get the key from Resend's dashboard:
# API Keys. EMAIL_FROM_ADDRESS's domain must also be verified under
# Resend's Domains page first (see docs/PREPROD_DEPLOY.md for the
# Cloudflare DNS records that verification needs) -- sending from an
# unverified domain is rejected outright.
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
RESEND_API_KEY=

# The session cookie is only sent back by the browser over HTTPS with
# this on -- correct once the Cloudflare Tunnel is actually in front
# (see docs/PREPROD_DEPLOY.md), wrong (cookie silently never sent) if
# set before that's true.
COOKIE_SECURE=true

# Requires the bundled Postgres container to already be running with
# ssl=on -- see docker-compose.preprod.yml's postgres command and the
# cert-generation steps in docs/PREPROD_DEPLOY.md. Setting this before
# that cert exists means the backend can't connect at all.
POSTGRES_SSLMODE=require

# Read once, by the one-time migration that seeds the "Default"
# MinioService row -- must be correct on this host's *first* boot of a
# fresh database, not toggled afterward. Also requires the bundled MinIO
# container to already have certs mounted (docker-compose.preprod.yml).
MINIO_SECURE=true
